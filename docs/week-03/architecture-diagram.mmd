            T4[detail.html\nPolicy Details]
        end

        subgraph Controller["🎮 Controller Layer\n(Spring MVC)"]
            HC[HomeController]
            PC[PolicyController]
        end

        subgraph Service["⚙️ Service Layer\n(Business Logic)"]
            PS[PolicyService\nStatus Classification\nValidation Logic\nSearch Logic]
        end

        subgraph Repository["🗄️ Repository Layer\n(Spring Data JPA)"]
            PR[PolicyRepository\nfindAll\nfindById\nfindByCustomerName\nfindUpcoming\nsave]
        end

        subgraph Model["📦 Model / Entity Layer"]
            PE[Policy.java\nJPA Entity]
        end
    end

    subgraph Database["💾 Database Layer"]
        H2[(H2 In-Memory DB\nPOLICY table)]
