# ==============================================================================
# Jenkins-Based Policy Renewal Reminder System
# .gitignore Configuration
# ==============================================================================

# Compiled class files & build directories
target/
*.class

# IDE & Editor settings
.idea/
*.iml
.vscode/
.classpath
.project
.settings/
*.ipr
*.iws

# Logs
*.log
logs/

# Environment files with secrets
.env
.env.local
.env.*.local

# Local archives / tools binaries
jdk-*/
*maven*/
*.zip
*.tar.gz

# OS specific files
.DS_Store
Thumbs.db

# ==============================================================================
# H2 Persistent Database Files (Milestone 2)
# NEVER commit database files — they contain customer policy data.
# The data/ directory itself is tracked (via data/.gitkeep) but its
# database files are excluded here.
# ==============================================================================
data/*.mv.db
data/*.trace.db
data/backups/
/backups/
# Also exclude any H2 files that land at the project root (e.g. during dev)
*.mv.db
*.trace.db
