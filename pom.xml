<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- =====================================================================
         Spring Boot Parent POM — provides dependency version management
         and sensible plugin defaults.
    ====================================================================== -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <!-- =====================================================================
         Project Coordinates
    ====================================================================== -->
    <groupId>com.policy.renewal</groupId>
    <artifactId>policy-renewal-system</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Jenkins-Based Policy Renewal Reminder System</name>
    <description>
        Academic project: A Spring Boot web application for managing insurance policy
        renewal reminders. Developed as part of a 15-week DevOps engineering project.
        Student: Basil Shaikh | Roll No: 23102C0026 | CMPN C
    </description>

    <!-- =====================================================================
         Properties
    ====================================================================== -->
    <properties>
        <!-- Java version — Spring Boot 3.x requires Java 17 minimum -->
        <java.version>17</java.version>
        <!-- Encoding — ensure consistent cross-platform builds -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <!-- =====================================================================
         Dependencies
         All versions are managed by the Spring Boot parent POM.
         Do not add version numbers here unless overriding a parent-managed version.
    ====================================================================== -->
    <dependencies>

        <!-- Spring Web MVC — provides @Controller, @GetMapping, etc. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Thymeleaf template engine — server-side HTML rendering -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

        <!-- Spring Data JPA — database access with Hibernate ORM -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Spring Boot Validation — @NotBlank, @NotNull, @Email, etc. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- H2 in-memory database — embedded, requires no installation -->
        <!-- scope: runtime means it is only needed when the application runs, not during compilation -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Spring Boot Test — JUnit 5, Mockito, MockMvc, etc. -->
        <!-- scope: test means this is only included when running tests, not in the final JAR -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <!-- =====================================================================
         Build Configuration
    ====================================================================== -->
    <build>
        <plugins>
            <!-- Spring Boot Maven Plugin — builds executable JAR -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
