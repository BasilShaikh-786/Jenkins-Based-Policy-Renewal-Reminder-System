# ==============================================================================
# Environment Configuration Template — Docker & Production Deployment
# Copy this file to .env and customize values as needed.
# NEVER commit the real .env file with secrets into version control.
# ==============================================================================

# Server Port
SERVER_PORT=8081

# Persistent Database Storage (H2 file path inside container)
SPRING_DATASOURCE_URL=jdbc:h2:file:./data/policyrenewaldb

# Initial Administrator Credentials (Bootstrap)
# Leave password blank to auto-generate a random one-time bootstrap password
APP_INITIAL_ADMIN_USERNAME=admin
APP_INITIAL_ADMIN_PASSWORD=

# Reminder Scheduler Configuration
# Set to true in production deployments to enable background daily checks at 08:00 AM IST
REMINDER_SCHEDULE_ENABLED=false
REMINDER_SCHEDULE_CRON=0 0 8 * * ?
SCHEDULER_TIMEZONE=Asia/Kolkata

# Notification Delivery Mode
# Set to false only when valid SMTP credentials are configured and tested
NOTIFICATION_SIMULATION_MODE=true

# JVM Options (tuned for containerized environments)
JAVA_OPTS=-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0
